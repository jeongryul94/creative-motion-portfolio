# 배포 주소 (sitemap, Open Graph에 사용)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# 공개 연락처 (Contact 섹션에 표시)
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# 문의 폼 전달 주소 (서버 전용). n8n / Make / Zapier / Slack 등 JSON POST를 받는 웹훅 URL.
# 비워두면 폼이 "연결되지 않음" 오류를 표시하고 이메일 문의를 안내합니다.
CONTACT_WEBHOOK_URL=
